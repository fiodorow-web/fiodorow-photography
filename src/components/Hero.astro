---
import { getImage } from "astro:assets";
import { heroSlides as slides, heroImageOpts } from "../data/hero-slides";
import { googleReviews } from "../data/google-reviews";

// Adresy generujemy w czasie builda, żeby móc ręcznie sterować tym,
// który obraz startuje od razu, a który dopiero po załadowaniu strony.
const rendered = await Promise.all(
  slides.map((slide) => getImage({ src: slide.image, ...heroImageOpts })),
);
---

<section class="relative w-full flex flex-col lg:flex-row lg:h-screen lg:min-h-[660px]">

  <!-- ZDJĘCIA: na telefonie u góry, na desktopie po prawej.
       Tekst NIE jest już częścią slajdu — dzięki temu nagłówek maluje się
       natychmiast i nie czeka na animację wejścia (to psuło LCP). -->
  <div
    id="hero-slider"
    class="relative order-1 lg:order-2 w-full lg:w-[56%] h-[54vh] min-h-[340px] lg:h-auto overflow-hidden bg-charcoal"
  >
    {
      slides.map((slide, index) => (
        <div
          class={`absolute inset-0 w-full h-full transition-opacity duration-[1600ms] ease-in-out ${index === 0 ? "opacity-100 z-10" : "opacity-0 z-0"}`}
          data-slide={index}
        >
          <img
            src={index === 0 ? rendered[index].src : undefined}
            srcset={index === 0 ? rendered[index].srcSet.attribute : undefined}
            data-src={index === 0 ? undefined : rendered[index].src}
            data-srcset={index === 0 ? undefined : rendered[index].srcSet.attribute}
            sizes="(min-width: 1024px) 56vw, 100vw"
            width={rendered[index].attributes.width}
            height={rendered[index].attributes.height}
            alt={slide.alt}
            class="absolute inset-0 w-full h-full object-cover"
            style={`object-position: ${slide.position}`}
            loading="eager"
            fetchpriority={index === 0 ? "high" : "low"}
            decoding={index === 0 ? "sync" : "async"}
          />
        </div>
      ))
    }

    <!-- Wskaźnik slajdów: cienkie kreski zamiast kropek -->
    <div class="absolute bottom-6 right-6 z-20 flex gap-2" aria-hidden="true">
      {slides.map((_, i) => (
        <span
          data-dot={i}
          class={`block h-px w-8 transition-colors duration-500 ${i === 0 ? "bg-white" : "bg-white/35"}`}
        />
      ))}
    </div>
  </div>

  <!-- TEKST: statyczny, na kremowym tle -->
  <div class="order-2 lg:order-1 w-full lg:w-[44%] bg-cream flex items-center px-6 sm:px-10 lg:px-14 xl:px-20 py-16 lg:py-0 lg:pt-24">
    <div class="max-w-md">

      <h1 class="!normal-case !tracking-normal mb-7">
        <span class="block font-sans text-[0.62rem] font-semibold tracking-[0.3em] uppercase text-olive mb-6">
          Fotograf ślubny · Siedlce
        </span>
        <span class="block font-serif !text-[2.75rem] sm:!text-6xl lg:!text-[4.2rem] !leading-[0.98] tracking-[-0.02em] text-charcoal">
          Tworzymy
          <i class="font-light italic text-olive">wspomnienia</i>
        </span>
      </h1>

      <p class="text-charcoal-light text-sm font-light leading-relaxed max-w-sm mb-10">
        Naturalny reportaż ślubny bez sztucznego pozowania. Jesteśmy duetem —
        jedno z nas jest tam, gdzie dzieje się główna akcja, drugie łapie to,
        co obok. Siedlce, Mazowsze, Podlasie i cała Polska.
      </p>

      <div class="flex flex-wrap items-center gap-x-8 gap-y-4 mb-12">
        <a
          href="/portfolio"
          class="group inline-flex items-center gap-3 border-b-2 border-charcoal pb-1.5 font-serif tracking-[0.18em] uppercase text-[0.8rem] text-charcoal hover:border-olive hover:text-olive transition-colors duration-300"
        >
          <span>Zobacz nasze prace</span>
          <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href="/kontakt"
          class="font-sans text-[0.7rem] tracking-[0.18em] uppercase text-charcoal-light hover:text-olive transition-colors duration-300"
        >
          Sprawdź wolny termin
        </a>
      </div>

      <a
        href={googleReviews.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex flex-wrap items-center gap-x-2.5 gap-y-1"
        aria-label={`Ocena ${googleReviews.rating} na 5 z ${googleReviews.count} opinii w Google`}
      >
        <span class="text-olive text-sm tracking-[0.15em]" aria-hidden="true">★★★★★</span>
        <span class="font-serif text-base text-charcoal">
          {googleReviews.rating.toFixed(1).replace(".", ",")}
        </span>
        <span class="text-charcoal-light text-[0.68rem] font-light">
          z {googleReviews.count} opinii w Google
        </span>
      </a>

    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    #hero-slider [data-slide] {
      transition: none !important;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLElement>("#hero-slider [data-slide]");
  const dots = document.querySelectorAll<HTMLElement>("#hero-slider [data-dot]");
  let current = 0;
  const count = slides.length;

  const show = (next: number) => {
    slides[current].classList.remove("opacity-100", "z-10");
    slides[current].classList.add("opacity-0", "z-0");
    dots[current]?.classList.replace("bg-white", "bg-white/35");

    current = next;

    slides[current].classList.remove("opacity-0", "z-0");
    slides[current].classList.add("opacity-100", "z-10");
    dots[current]?.classList.replace("bg-white/35", "bg-white");
  };

  // Slajdy 2-4 dostają adresy dopiero po załadowaniu strony. Leżą w kadrze
  // (inset-0), więc loading="lazy" by ich nie odroczyło i konkurowałyby
  // o łącze z obrazem odpowiedzialnym za LCP.
  const hydrateRest = () => {
    document.querySelectorAll<HTMLImageElement>("#hero-slider img[data-srcset]").forEach((img) => {
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      if (img.dataset.src) img.src = img.dataset.src;
      delete img.dataset.srcset;
      delete img.dataset.src;
    });
  };

  if (document.readyState === "complete") hydrateRest();
  else window.addEventListener("load", hydrateRest, { once: true });

  if (count > 1) {
    setInterval(() => show((current + 1) % count), 6000);
  }
</script>
