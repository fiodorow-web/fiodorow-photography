---
import BaseLayout from "../layouts/BaseLayout.astro";
import { googleReviews } from "../data/google-reviews";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import portretDuetu from "../assets/about/about.jpg";

const eventTypes = [
  "Reportaż ślubny",
  "Sesja poślubna",
  "Sesja narzeczeńska",
  "Reportaż chrztu",
  "Sesja plenerowa",
  "Fotobudka",
  "Inne",
];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://fiodorowphotography.pl",
  name: "Fiodorow Photography",
  description: "Duet fotografów ślubnych z Siedlec. Naturalny reportaż ślubny, sesje narzeczeńskie i poślubne.",
  url: "https://fiodorowphotography.pl",
  telephone: "+48660872121",
  email: "fiodorowphotography@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Siedlce",
    postalCode: "08-110",
    addressRegion: "Mazowieckie",
    addressCountry: "PL",
  },
};

// Klasy powtarzane w polach — jedna linia zamiast obwódek karty.
const field =
  "w-full bg-transparent border-0 border-b border-charcoal/20 px-0 py-3 text-sm font-light text-charcoal placeholder:text-charcoal/25 focus:border-olive focus:ring-0 focus:outline-none transition-colors";
const label =
  "block text-[0.6rem] font-semibold tracking-[0.18em] uppercase text-charcoal-light/70 mb-1";
---

<BaseLayout
  title="Kontakt — Fotograf Ślubny Siedlce | Fiodorow Photography"
  description="Napiszcie do nas o swoim dniu. Odpisujemy w ciągu 6 godzin — z cennikiem, wolnymi terminami i odpowiedziami na Wasze pytania. Fotograf ślubny Siedlce."
  breadcrumbs={[{ name: "Kontakt", href: "/kontakt" }]}
>
  <Header currentPath="/kontakt" />

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <main class="bg-cream pt-24 lg:pt-0">
    <div class="lg:grid lg:grid-cols-[minmax(0,44%)_minmax(0,56%)] lg:min-h-screen">

      <!-- LEWA: portret duetu, do krawędzi, bez ramki i cienia -->
      <!-- Kolumna rozciąga się na całą wysokość siatki, a przykleja się
           dopiero wewnętrzny kontener wysokości ekranu. Bez tego kolumna
           kończyła się po jednym ekranie i niżej zostawało puste tło. -->
      <div class="relative h-[52vh] lg:h-auto">
       <div class="relative h-full lg:sticky lg:top-0 lg:h-screen overflow-hidden">
        <Image
          src={portretDuetu}
          alt="Weronika i Mateusz — duet fotografów ślubnych z Siedlec"
          class="absolute inset-0 w-full h-full object-cover"
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 44vw, 100vw"
          quality={82}
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-x-0 bottom-0 p-8 lg:p-12 bg-gradient-to-t from-charcoal/70 to-transparent">
          <p class="font-serif text-white/95 text-lg lg:text-xl italic leading-snug max-w-sm">
            Zanim zrobimy Wam zdjęcia, chcemy Was poznać.
          </p>
          <p class="text-white/70 text-[0.65rem] tracking-[0.2em] uppercase mt-3">
            Weronika i Mateusz
          </p>
        </div>
       </div>
      </div>

      <!-- PRAWA: treść i formularz wprost na kremowym tle -->
      <div class="px-6 sm:px-10 lg:px-16 xl:px-24 py-16 lg:pt-40 lg:pb-24">
        <div class="max-w-xl">

          <p class="text-[0.6rem] font-semibold tracking-[0.25em] uppercase text-olive mb-5">
            Kontakt
          </p>
          <h1 class="font-serif !text-4xl md:!text-5xl lg:!text-6xl !leading-[1.05] text-charcoal mb-8 tracking-tight">
            Opowiedzcie nam<br /><i class="font-light italic text-olive">o swoim dniu</i>
          </h1>

          <!-- Co się stanie po wysłaniu — to jest największa bariera, nie długość formularza -->
          <div class="border-l border-olive/40 pl-5 mb-10">
            <p class="text-charcoal-light text-sm font-light leading-relaxed">
              Odpisujemy <strong class="font-medium text-charcoal">w ciągu 6 godzin</strong>.
              Dostaniecie pełny cennik, wolne terminy i odpowiedź na wszystko,
              o co zapytacie — bez zobowiązań i bez nagabywania.
            </p>
          </div>

          <a
            href={googleReviews.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex flex-wrap items-center gap-x-2.5 gap-y-1 mb-14 group"
            aria-label={`Ocena ${googleReviews.rating} na 5 z ${googleReviews.count} opinii w Google — otwórz wizytówkę`}
          >
            <span class="text-olive text-sm tracking-[0.15em]" aria-hidden="true">★★★★★</span>
            <span class="font-serif text-base text-charcoal">
              {googleReviews.rating.toFixed(1).replace(".", ",")}
            </span>
            <span class="text-charcoal-light text-[0.7rem] font-light">
              z {googleReviews.count} opinii w Google
            </span>
          </a>

          <form id="contact-form" class="space-y-12">
            <!-- Honeypot — niewidoczny dla ludzi, boty go wypełniają -->
            <div class="absolute opacity-0 top-0 left-0 h-0 w-0 -z-10" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" id="form-ts" name="formTimestamp" value="" />

            <!-- KROK 1: o ślubie. Zaczynamy od pytań, na które para zna
                 odpowiedź i które dotyczą jej, a nie nas. -->
            <fieldset class="space-y-7">
              <legend class="font-serif text-sm tracking-[0.2em] uppercase text-charcoal mb-7 flex items-baseline gap-3">
                <span class="text-olive text-xs">01</span> Wasz dzień
              </legend>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
                <div>
                  <label for="eventDate" class={label}>Data ślubu lub sesji</label>
                  <input type="date" id="eventDate" name="eventDate" class={field} />
                </div>
                <div>
                  <label for="eventLocation" class={label}>Lokalizacja *</label>
                  <input
                    type="text"
                    id="eventLocation"
                    name="eventLocation"
                    required
                    class={field}
                    placeholder="np. Siedlce"
                  />
                </div>
              </div>

              <div>
                <label for="eventType" class={label}>Co planujecie? *</label>
                <div class="relative">
                  <select id="eventType" name="eventType" required class={`${field} appearance-none cursor-pointer pr-8`}>
                    <option value="" disabled selected>Wybierzcie rodzaj sesji…</option>
                    {eventTypes.map((type) => <option value={type}>{type}</option>)}
                  </select>
                  <svg class="w-3 h-3 absolute right-1 top-1/2 -translate-y-1/2 pointer-events-none text-charcoal-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>
            </fieldset>

            <!-- KROK 2: kontakt -->
            <fieldset class="space-y-7">
              <legend class="font-serif text-sm tracking-[0.2em] uppercase text-charcoal mb-7 flex items-baseline gap-3">
                <span class="text-olive text-xs">02</span> Jak się z Wami skontaktować
              </legend>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
                <div>
                  <label for="firstName" class={label}>Imię *</label>
                  <input type="text" id="firstName" name="firstName" required class={field} placeholder="Twoje imię" />
                </div>
                <div>
                  <label for="lastName" class={label}>Nazwisko *</label>
                  <input type="text" id="lastName" name="lastName" required class={field} placeholder="Twoje nazwisko" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
                <div>
                  <label for="email" class={label}>Email *</label>
                  <input type="email" id="email" name="email" required class={field} placeholder="adres@email.com" />
                </div>
                <div>
                  <label for="phone" class={label}>Telefon</label>
                  <input type="tel" id="phone" name="phone" class={field} placeholder="+48 000 000 000" />
                </div>
              </div>

              <div>
                <label for="message" class={label}>Wiadomość *</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class={`${field} resize-none`}
                  placeholder="Gdzie się poznaliście? Jaki macie pomysł na ten dzień? Piszcie śmiało — im więcej wiemy, tym lepiej odpowiemy."
                ></textarea>
              </div>
            </fieldset>

            <div class="pt-2">
              <button
                type="submit"
                id="submit-btn"
                class="group inline-flex items-center gap-4 border-b-2 border-charcoal pb-2 font-serif tracking-[0.2em] uppercase text-sm text-charcoal hover:border-olive hover:text-olive transition-colors duration-300"
              >
                <span>Wyślij wiadomość</span>
                <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </button>
            </div>

            <div id="form-message" class="hidden rounded p-4 text-sm"></div>
          </form>

          <!-- Dane kontaktowe: cicho, tekstem, bez karty i bez mapy -->
          <div class="mt-20 pt-10 border-t border-charcoal/10 grid grid-cols-1 sm:grid-cols-3 gap-8">
            <div>
              <p class="text-[0.6rem] font-semibold tracking-[0.18em] uppercase text-charcoal-light/70 mb-3">Telefon</p>
              <a href="tel:+48660872121" class="block text-charcoal text-sm font-light hover:text-olive transition-colors">660 872 121</a>
              <a href="tel:+48515631646" class="block text-charcoal text-sm font-light hover:text-olive transition-colors">515 631 646</a>
            </div>
            <div>
              <p class="text-[0.6rem] font-semibold tracking-[0.18em] uppercase text-charcoal-light/70 mb-3">Email</p>
              <a href="mailto:fiodorowphotography@gmail.com" class="text-charcoal text-sm font-light hover:text-olive transition-colors break-all">fiodorowphotography@gmail.com</a>
            </div>
            <div>
              <p class="text-[0.6rem] font-semibold tracking-[0.18em] uppercase text-charcoal-light/70 mb-3">Gdzie pracujemy</p>
              <p class="text-charcoal text-sm font-light leading-relaxed">
                Siedlce, Mazowsze, Podlasie.<br />
                Dojeżdżamy w każde miejsce w Polsce.
              </p>
              <div class="flex gap-4 mt-4">
                <a href="https://instagram.com/fiodorow_photography" target="_blank" rel="noopener noreferrer" class="text-[0.65rem] tracking-[0.15em] uppercase text-charcoal-light hover:text-olive transition-colors">Instagram</a>
                <a href="https://facebook.com/fiodorowphotography" target="_blank" rel="noopener noreferrer" class="text-[0.65rem] tracking-[0.15em] uppercase text-charcoal-light hover:text-olive transition-colors">Facebook</a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const formMessage = document.getElementById("form-message") as HTMLDivElement;
  const formTsInput = document.getElementById("form-ts") as HTMLInputElement;

  // Set timestamp when page loads (bots won't have realistic timing)
  if (formTsInput) {
    formTsInput.value = Date.now().toString();
  }

  // Preselect event type when arriving from /fotobudka (?usluga=fotobudka)
  const usluga = new URLSearchParams(window.location.search).get("usluga");
  if (usluga === "fotobudka") {
    const eventTypeSelect = document.getElementById(
      "eventType",
    ) as HTMLSelectElement | null;
    if (eventTypeSelect) eventTypeSelect.value = "Fotobudka";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Initial state
    const originalBtnText = submitBtn.innerHTML;
    submitBtn.innerHTML = "<span>Wysyłanie...</span>";
    submitBtn.disabled = true;
    formMessage.classList.add("hidden");
    formMessage.className = "hidden rounded-lg p-4 text-sm text-center";

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    try {
      // Simulate API call for now (or implement actual endpoint)
      // await new Promise(resolve => setTimeout(resolve, 1500));

      const response = await fetch("/api/contact", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok) {
        formMessage.textContent =
          "Dziękujemy! Wiadomość została wysłana. Odpowiemy najszybciej jak to możliwe.";
        formMessage.classList.remove("hidden");
        formMessage.classList.add(
          "bg-olive/10",
          "text-olive",
          "border",
          "border-olive/20",
        );
        form.reset();
        // GA4: konwersja — realne zapytanie wysłane przez formularz kontaktowy.
        // Consent Mode zadba o to, by nie wysłać przy braku zgody.
        if (typeof (window as any).gtag === "function") {
          // Enhanced Conversions — przekaż dane z formularza do dopasowania.
          // Google hashuje (SHA-256) po stronie klienta. Wymaga włączenia
          // „Konwersje rozszerzone" w Google Ads (metoda: tag Google/gtag).
          const ecEmail = (data.email || "").toString().trim().toLowerCase();
          let ecPhone = (data.phone || "").toString().replace(/[^\d+]/g, "");
          if (ecPhone && ecPhone.indexOf("+") !== 0) {
            const digits = ecPhone.replace(/\D/g, "");
            ecPhone = digits.length === 9 ? "+48" + digits : "+" + digits;
          }
          const userData: Record<string, string> = {};
          if (ecEmail) userData.email = ecEmail;
          if (ecPhone) userData.phone_number = ecPhone;
          if (Object.keys(userData).length) {
            (window as any).gtag("set", "user_data", userData);
          }
          (window as any).gtag("event", "generate_lead", {
            method: "formularz_kontaktowy",
            value: 1,
            currency: "PLN",
          });
          // Google Ads dostaje tę konwersję z importu GA4: generate_lead (wyżej)
          // jest kluczowym zdarzeniem GA4 i trafia do Ads jako główne działanie
          // w kategorii "Przesłania formularzy kontaktowych". Dlatego NIE wysyłamy
          // tu drugiego, osobnego zdarzenia — byłoby liczone podwójnie.
          // Enhanced Conversions bierze user_data ustawione wyżej.
        }
        // Meta Pixel: standardowe zdarzenie Lead (wysłany formularz).
        // Aktywne tylko gdy ustawiono Pixel ID w BaseLayout → window.META_PIXEL.
        const fbq = (window as any).fbq;
        if (typeof fbq === "function") {
          fbq("track", "Lead", {
            content_name: "formularz_kontaktowy",
            value: 1,
            currency: "PLN",
          });
        }
      } else {
        throw new Error(result.error || "Failed to send");
      }
    } catch (error) {
      formMessage.textContent =
        "Przepraszamy, wystąpił błąd. Spróbuj ponownie lub skontaktuj się telefonicznie.";
      formMessage.classList.remove("hidden");
      formMessage.classList.add(
        "bg-red-50",
        "text-red-600",
        "border",
        "border-red-100",
      );
    } finally {
      submitBtn.innerHTML = originalBtnText;
      submitBtn.disabled = false;
    }
  });
</script>
